{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-worktree-remove.sh\"",
            "if": "Bash(git worktree remove*)",
            "timeout": 15,
            "statusMessage": "Checking the worktree for local-only files"
          }
        ]
      }
    ]
  }
}
