{
  "name": "santolina-web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "tsx --env-file=.env.local scripts/seed-plants.ts",
    "round:progress": "tsx --env-file=.env.local scripts/round-progress.ts",
    "tokens:usage": "tsx scripts/scan-token-usage.ts",
    "tokens:check": "tsx scripts/check-tokens.ts && tsx scripts/scan-token-usage.ts && git diff --exit-code components/design-system/token-consumers.generated.ts",
    "migrations:check": "tsx --env-file=.env.local scripts/check-migration-drift.ts",
    "catalog:state": "tsx --env-file=.env.local scripts/catalog-state.ts",
    "catalog:state:check": "tsx --env-file=.env.local scripts/catalog-state.ts && git diff --exit-code ../../docs/catalog-state.md",
    "round:run": "tsx --env-file=.env.local scripts/run-round.ts",
    "runbook": "tsx scripts/generate-runbook-doc.ts",
    "runbook:check": "tsx scripts/generate-runbook-doc.ts && git diff --exit-code ../../docs/round-runbook.md",
    "trigger:contract": "tsx --env-file=.env.local scripts/test-editorial-trigger.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@paradoxui/tokens": "workspace:*",
    "@paradoxui/ui": "workspace:*",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.2",
    "@vercel/analytics": "^2.0.1",
    "ai": "^3.0.0",
    "framer-motion": "^11.0.0",
    "next": "^15.0.0",
    "openai": "^4.28.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@paradoxui/eslint-config": "workspace:*",
    "@paradoxui/typescript-config": "workspace:*",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.23.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  }
}
